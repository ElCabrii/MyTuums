{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "command": ["pnpm", "exec", "tsc", "--lsp", "--stdio"]
    },
    "oxlint": {
      "command": ["pnpm", "exec", "oxlint", "--lsp"]
    }
  },
  "formatter": {
    "prettier": {
      "command": ["pnpm", "exec", "prettier", "--write", "$FILE"]
    }
  }
}
