{
  "name": "@my-tuums/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "default": "./src/migrate.ts"
    },
    "./promote": {
      "types": "./src/promote.ts",
      "default": "./src/promote.ts"
    },
    "./grant-founder-badge": {
      "types": "./src/grant-founder-badge.ts",
      "default": "./src/grant-founder-badge.ts"
    },
    "./stamp-join-badges": {
      "types": "./src/stamp-join-badges.ts",
      "default": "./src/stamp-join-badges.ts"
    },
    "./testing/d1": {
      "types": "./src/testing/d1.ts",
      "default": "./src/testing/d1.ts"
    },
    "./poc-database": {
      "types": "./scripts/poc-database.ts",
      "default": "./scripts/poc-database.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.d1.config.ts",
    "db:check": "drizzle-kit check --config drizzle.d1.config.ts",
    "db:generate:auth": "NODE_OPTIONS=\"--import tsx\" npx @better-auth/cli generate --config ../auth/schema.config.ts --output ./src/schema/auth.ts -y && tsx ./scripts/patch-auth-schema.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:rehearse:recovery": "tsx scripts/rehearse-recovery.ts",
    "db:test:setup": "tsx scripts/setup-test-db.ts",
    "db:promote": "tsx scripts/admin.ts promote",
    "db:grant:founder": "tsx scripts/admin.ts founder",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:prepare:preview": "tsx scripts/prepare-preview-import.ts",
    "test:unit": "tsx --test scripts/*.test.ts",
    "deploy:preview": "tsx scripts/deploy-preview.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@my-tuums/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.19.0",
    "@typescript/native": "catalog:",
    "miniflare": "5.20260908.0-alpha",
    "@cloudflare/workers-types": "5.20260908.1",
    "wrangler": "4.130.0",
    "zod": "catalog:"
  }
}
