{
  "name": "@my-tuums/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "default": "./src/migrate.ts"
    },
    "./promote": {
      "types": "./src/promote.ts",
      "default": "./src/promote.ts"
    },
    "./grant-founder-badge": {
      "types": "./src/grant-founder-badge.ts",
      "default": "./src/grant-founder-badge.ts"
    }
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:check": "dotenv -e ../../.env -- drizzle-kit check",
    "db:generate:auth": "dotenv -e ../../.env -- npx @better-auth/cli generate --config ../auth/src/index.ts --output ./src/schema/auth.ts -y && tsx ./scripts/patch-auth-schema.ts",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:push": "dotenv -e ../../.env -- drizzle-kit push",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "db:test:setup": "dotenv -e ../../.env -- tsx scripts/setup-test-db.ts",
    "db:promote": "dotenv -e ../../.env -- tsx scripts/promote-user.ts",
    "db:grant:founder": "dotenv -e ../../.env -- tsx scripts/grant-founder-badge.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@my-tuums/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.19.0",
    "@typescript/native": "catalog:"
  }
}
