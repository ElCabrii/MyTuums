{
  "name": "@my-tuums/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "default": "./src/migrate.ts"
    }
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:generate:auth": "dotenv -e ../../.env -- npx @better-auth/cli generate --config ../auth/src/index.ts --output ./src/schema/auth.ts -y && node ./scripts/patch-auth-schema.mjs",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:push": "dotenv -e ../../.env -- drizzle-kit push",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "db:test:setup": "dotenv -e ../../.env -- tsx scripts/setup-test-db.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@my-tuums/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.19.0",
    "typescript": "catalog:"
  }
}
