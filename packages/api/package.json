{
  "name": "@my-tuums/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./storage": {
      "types": "./src/storage.ts",
      "default": "./src/storage.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@my-tuums/auth": "workspace:*",
    "@my-tuums/db": "workspace:*",
    "@orpc/server": "^1.5.0",
    "drizzle-orm": "^0.44.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@my-tuums/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "^17.2.3",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
