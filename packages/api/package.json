{
  "name": "@my-tuums/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./storage": {
      "types": "./src/storage.ts",
      "default": "./src/storage.ts"
    },
    "./public-post-head": {
      "types": "./src/public-post-head.ts",
      "default": "./src/public-post-head.ts"
    },
    "./dimensions": {
      "types": "./src/dimensions.ts",
      "default": "./src/dimensions.ts"
    },
    "./post-image": {
      "types": "./src/post-image.ts",
      "default": "./src/post-image.ts"
    },
    "./roles": {
      "types": "./src/roles.ts",
      "default": "./src/roles.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "reconcile:media": "dotenv -e ../../.env -- tsx scripts/reconcile-media.ts",
    "prune:notifications": "dotenv -e ../../.env -- tsx scripts/prune-notifications.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@my-tuums/auth": "workspace:*",
    "@my-tuums/db": "workspace:*",
    "@orpc/server": "^1.5.0",
    "drizzle-orm": "^0.45.2",
    "sharp": "^0.35.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/utils": "catalog:",
    "@my-tuums/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "tsx": "4.23.1",
    "vitest": "^4.1.10"
  }
}
