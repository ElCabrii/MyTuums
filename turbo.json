{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      // The web build writes the git-ignored generated files (the TanStack
      // route tree and the Paraglide messages) into `src/`, not `dist/`, so
      // they must be declared here too or a cached build restores only the
      // bundle and leaves `lint`/`typecheck` to resolve imports that no
      // longer exist on disk.
      "outputs": ["dist/**", ".wrangler/dist/**", "src/routeTree.gen.ts", "src/paraglide/**"]
    },
    "@my-tuums/server#build": {
      "dependsOn": ["^build", "@my-tuums/web#build"],
      "outputs": [".wrangler/dist/**"]
    },
    // Artifact tests must use completed app and branding builds, including assets.
    "@my-tuums/server#test:unit": {
      "dependsOn": ["build", "@my-tuums/branding#build"],
      "cache": false
    },
    // `lint` and `typecheck` need the generated, git-ignored files that the
    // web build produces (`routeTree.gen.ts`, `src/paraglide/**`), so they
    // depend on the package's OWN build — `^build` alone would only build
    // dependencies, whose dist is never referenced (workspace packages
    // export their source). CI used to paper over this by ordering its steps;
    // a contributor running `pnpm typecheck` on a fresh clone gets the same
    // guarantee (issue #59).
    "lint": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "cache": false
    },
    "test:unit": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
