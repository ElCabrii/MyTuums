# Postgres container credentials (used by docker-compose.yml and by
# DATABASE_URL below). Pick a real value for anything beyond local dev.
POSTGRES_PASSWORD=postgrespassword

# Database Connection (Docker Compose default). Use `localhost` for
# processes running on the host (pnpm dev, pnpm db:migrate, ...); the
# `server` container gets its own DATABASE_URL pointed at the `postgres`
# service name, set directly in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/mytuums

# Better Auth Configuration
# BETTER_AUTH_SECRET must be at least 32 characters of REAL random data —
# not this placeholder. Generate one with, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3001

# Server Configuration (optional — defaults shown)
WEB_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Whether to read the caller's IP from the X-Forwarded-For header instead of
# the socket. The /rpc rate limiter keys anonymous callers by IP, and this
# header is client-supplied — turning this on when nothing in front of the
# server overwrites it lets a caller mint a fresh rate limit bucket per
# request. Only set it to true behind a reverse proxy you control.
TRUST_PROXY=false
