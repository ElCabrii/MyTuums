# Single source of env for every host-side process. Copy this file to .env:
# package scripts load it via `dotenv -e ../../.env` and the web app reads
# it through Vite's envDir. Commented-out values are optional — each
# section below explains what it does and how the server behaves unset.

# Postgres container credentials (used by docker-compose.yml and by
# DATABASE_URL below). Pick a real value for anything beyond local dev.
POSTGRES_PASSWORD=postgrespassword

# Database Connection (Docker Compose default). Use `localhost` for
# processes running on the host (pnpm dev, pnpm db:migrate, ...); the
# `server` container gets its own DATABASE_URL pointed at the `postgres`
# service name, set directly in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/mytuums

# Where the integration and E2E suites connect. Optional: when unset it is
# derived from DATABASE_URL by suffixing the database name with `_test`, so
# the default above becomes `mytuums_test`. Create and migrate it with
# `pnpm db:test:setup`. The destructive test helpers refuse to run unless the
# database name ends in `_test`.
# DATABASE_URL_TEST=postgresql://postgres:postgrespassword@localhost:5432/mytuums_test

# Better Auth Configuration
# BETTER_AUTH_SECRET must be at least 32 characters of REAL random data —
# not this placeholder. Generate one with, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3001

# Server Configuration (optional — defaults shown)
# Production sets WEB_ORIGIN=https://mytuums.com — see docs/operations.md.
WEB_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1
# The compose `server` service overrides HOST to 0.0.0.0 — Docker port
# mapping cannot reach a container's loopback (see docker-compose.yml).
NODE_ENV=development

# Where the web app's Vite dev server proxies /rpc and /api/auth. Optional;
# defaults to http://localhost:3001. The E2E stack sets it to :3101 so the
# suite can run beside a live `pnpm dev` instead of fighting it for the port.
# RPC_TARGET=http://localhost:3001


# --- OAuth providers (all optional) -----------------------------------------
# Each provider is registered only when BOTH halves are present, so leaving a
# block commented out simply means no button for it. Setting only one half is
# refused at boot - see the superRefine in apps/server/src/env.ts.
#
# Callback URL to register with each provider:
#   $BETTER_AUTH_URL/api/auth/callback/<provider>
# e.g. http://localhost:3001/api/auth/callback/google

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Google One Tap reads its client id in the BROWSER, so it needs the VITE_
# prefix to be exposed by Vite - the unprefixed GOOGLE_CLIENT_ID above is
# server-side only and deliberately never reaches the bundle. Same value.
# Register your web origin under "Authorized JavaScript origins" in the Google
# Cloud console or the prompt silently never appears.
# VITE_GOOGLE_CLIENT_ID=

# Which sign-in buttons the web app renders. Must match the providers you gave
# credentials to above - the browser cannot see server env, so this is the one
# place the two lists have to be kept in agreement. Unknown ids are ignored.
# VITE_SOCIAL_PROVIDERS=google,discord,twitch

# Public GA4 measurement id (for example G-XXXXXXXXXX). Unset disables the
# consent banner, tag loading, page-view tracking, and GA-specific CSP sources.
# The same value is retained by the production image so the server policy and
# the web bundle cannot disagree. After enabling it, configure the GA4 property
# for 14-month data retention as documented in docs/operations.md.
# VITE_GA_MEASUREMENT_ID=


# --- IGDB game catalog (optional as a pair) ---------------------------------
# Credentials for the game-catalog sync (issue #314). Same Twitch developer
# portal as the TWITCH_ sign-in pair above, but a DIFFERENT client with a
# different purpose: these are never read by the serving app, only by
# `pnpm games:sync` and its Railway cron twin. Setting only one half is
# refused at boot - see the superRefine in apps/server/src/env.ts. Unset is
# the normal serving state: the catalog just stops refreshing.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=


# --- Email (optional) -------------------------------------------------------
# Without RESEND_API_KEY, auth emails are printed to the server console in
# development and *throw* in production rather than being dropped silently.
# TOTP two-factor, sign-up and sign-in all work fully without this; email
# two-factor codes, address verification and password reset do not.
# EMAIL_FROM must be on a domain verified with Resend.
# RESEND_API_KEY=
# EMAIL_FROM=MyTuums <noreply@example.com>


# --- Error tracking (optional) ----------------------------------------------
# Sentry DSN (https://<org>.ingest.sentry.io/<project>). Unset (dev, CI), the
# server simply has no error-tracking client — every request still carries an
# x-request-id header and an access log line either way. When set, unhandled
# request errors are reported with the request id attached, process crashes
# are reported as-is, and the queue is flushed before shutdown.
# Create a project in your Sentry org (Node.js) and paste its DSN here.
# SENTRY_DSN=


# --- Passkeys / auth rate limiting (optional) -------------------------------
# The WebAuthn Relying Party ID. Defaults to WEB_ORIGIN's hostname, which is
# right for a same-origin deployment. WebAuthn ignores scheme and port, so
# `localhost` covers both the dev (:5173) and E2E (:5273) web ports.
# PASSKEY_RP_ID=localhost

# Better Auth's own rate limiting, on unless set to false. The Playwright suite
# sets it to false because it drives every sign-in from one IP and would
# otherwise trip the credential-guessing limits it is not the target of.
# AUTH_RATE_LIMIT=true


# --- Object storage for avatars and banners (optional as a GROUP) -----------
# A Railway Storage Bucket, used in dev and CI as well as production, so the
# upload path that ships is the one every test exercises.
#
# All four of ENDPOINT/BUCKET/ACCESS_KEY_ID/SECRET_ACCESS_KEY or none of them:
# with none set the server boots normally and only the two upload procedures
# refuse (NOT_IMPLEMENTED), exactly like an unconfigured OAuth provider. With
# only some set, apps/server/src/env.ts refuses to boot — a bucket missing one
# variable fails at runtime with an S3 error nobody can trace back to .env.
#
# Where to find the values: Railway dashboard -> project -> the bucket ->
# Credentials tab. Note two traps:
#   * S3_BUCKET is the bucket's *globally unique* S3 name — the display name
#     plus a short hash, e.g. `mytuums-media-dev-a1b2c3d4`. It is NOT the
#     display name, and it is NOT `RAILWAY_BUCKET_NAME`.
#   * S3_ENDPOINT must be the PUBLIC endpoint, currently
#     `https://t3.storageapi.dev` — copy it from the Credentials tab rather
#     than from any doc, including this one; Railway has changed it once
#     already and their own examples still show the old value.
#     `storage.railway.internal` only resolves from inside Railway's network,
#     so a laptop or a CI runner using it fails to connect.
#
# Each Railway ENVIRONMENT owns its own bucket, and that is what keeps dev, CI
# and production apart: `production` has `mytuums-media`, the `dev` environment
# has `mytuums-dev-media`, the `ci` environment has `mytuums-ci-media`, and the
# credentials of one cannot address another. This matters because the E2E
# suite deletes objects by prefix as part of its cleanup — pointed at the
# production bucket, that cleanup deletes real users' avatars. Take the values
# below from the `dev` environment's bucket.
# S3_ENDPOINT=https://t3.storageapi.dev
# S3_BUCKET=mytuums-dev-media-xxxxxxxx
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto


# --- Serving the built web app from the API origin (production only) --------
# Absolute path to apps/web/dist. When set, the server also serves the SPA,
# which is what makes a deployment single-origin. That is a requirement rather
# than a preference: apps/web/src/lib/orpc.ts resolves /rpc against
# window.location.origin, and uploaded avatars are stored as relative /media/
# paths — split the two across origins and RPC and every image break together.
#
# Leave this UNSET for local development: Vite serves the app on :5173 and
# proxies /rpc, /api/auth and /media to this server. The Docker image sets it
# itself (see apps/server/Dockerfile).
# WEB_DIST=/app/apps/web/dist

# Absolute path to apps/branding/dist. When set, requests whose Host is
# about.mytuums.com are served from the built branding site instead of the app
# (see apps/server/src/branding-host.ts). Leave UNSET for local development:
# `pnpm --filter @my-tuums/branding dev` serves it on its own Vite port. The
# Docker image sets it itself (see apps/server/Dockerfile).
# BRANDING_DIST=/app/apps/branding/dist
