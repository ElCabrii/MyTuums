{
  "name": "my-tuums",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint eslint.config.ts scripts && turbo run lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "docs:check": "tsx scripts/check-docs.ts",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @my-tuums/api test:integration",
    "test:e2e": "pnpm --filter @my-tuums/e2e e2e",
    "test:e2e:ui": "pnpm --filter @my-tuums/e2e e2e:ui",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:test:setup": "pnpm --filter @my-tuums/db db:test:setup",
    "db:promote": "pnpm --filter @my-tuums/db db:promote",
    "lighthouse": "lighthouse http://localhost:3001/ --output=json --output-path=lighthouse-reports/mobile.json --chrome-flags=\"--headless=new\" --quiet",
    "lighthouse:desktop": "lighthouse http://localhost:3001/ --preset=desktop --output=json --output-path=lighthouse-reports/desktop.json --chrome-flags=\"--headless=new\" --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@my-tuums/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.19.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0"
  }
}
