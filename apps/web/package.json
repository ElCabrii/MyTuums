{
  "name": "@my-tuums/web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "test": "pnpm paraglide && vitest run",
    "test:unit": "pnpm paraglide && vitest run",
    "test:watch": "pnpm paraglide && vitest",
    "test:node": "pnpm paraglide && vitest run --project node",
    "test:dom": "pnpm paraglide && vitest run --project dom"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/passkey": "catalog:",
    "@fontsource-variable/inter": "^5.3.0",
    "@my-tuums/api": "workspace:*",
    "@my-tuums/auth": "workspace:*",
    "@orpc/client": "^1.5.0",
    "@orpc/tanstack-query": "^1.5.0",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-router": "^1.120.7",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "jotai": "^2.12.5",
    "jotai-effect": "^2.4.1",
    "jotai-family": "^1.1.0",
    "jotai-tanstack-query": "^0.11.0",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-qr-code": "^2.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.0.13",
    "@my-tuums/tsconfig": "workspace:*",
    "@orpc/server": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.120.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
