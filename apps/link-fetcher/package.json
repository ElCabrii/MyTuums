{
  "name": "@my-tuums/link-fetcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && wrangler deploy --dry-run --outdir .wrangler/dist",
    "types": "wrangler types worker/worker-configuration.d.ts --env-interface LinkEnv --include-runtime false",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint src worker tsup.config.ts",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@my-tuums/api": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "@my-tuums/tsconfig": "workspace:*",
    "@typescript/native": "catalog:",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "vitest": "^4.1.10",
    "wrangler": "4.130.0"
  }
}
