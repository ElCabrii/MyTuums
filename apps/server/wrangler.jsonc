{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mytuums-build-app",
  "account_id": "734f3b84571b1967e6940140a0b7d75f",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mytuums-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/drizzle-d1",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mytuums-local-media",
      "jurisdiction": "eu",
      "remote": false,
    },
  ],
  "images": { "binding": "IMAGES", "remote": false },
  "stream": { "binding": "STREAM", "remote": false },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@mytuums.com"],
      "remote": false,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API_COUNTERS", "class_name": "RateLimitCounter" },
      { "name": "AUTH_COUNTERS", "class_name": "AuthRateLimitCounter" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimitCounter", "AuthRateLimitCounter"],
    },
  ],
  "services": [
    {
      "binding": "LINK_FETCHER",
      "service": "mytuums-build-link-fetcher",
      "entrypoint": "LinkFetchService",
    },
  ],
  "workflows": [
    {
      "binding": "VIDEO_WORKFLOW",
      "name": "mytuums-build-video",
      "class_name": "VideoWorkflow",
      "script_name": "mytuums-build-jobs",
    },
  ],
  "vars": {
    "WEB_ORIGIN": "https://preview.mytuums.com",
    "ACCESS_TEAM_DOMAIN": "https://mytuums.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "6a8abc536bcca8df6a610bf39889bf089c297137124b0ce515dfb949130beca5",
    "CLOUDFLARE_ACCOUNT_ID": "734f3b84571b1967e6940140a0b7d75f",
    "STREAM_NAMESPACE": "mytuums-preview",
    "EMAIL_FROM": "noreply@mytuums.com",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "APPEAL_TOKEN_SECRET",
      "STREAM_API_TOKEN",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "TWITCH_CLIENT_ID",
      "TWITCH_CLIENT_SECRET",
    ],
  },
  "limits": { "cpu_ms": 30000 },
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
  },
}
