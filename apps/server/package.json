{
  "name": "@my-tuums/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsup",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "games:sync": "dotenv -e ../../.env -- tsx src/games-sync.ts"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.0.1",
    "@my-tuums/api": "workspace:*",
    "@my-tuums/auth": "workspace:*",
    "@my-tuums/db": "workspace:*",
    "@opentelemetry/core": "^2.10.0",
    "@orpc/server": "^1.5.0",
    "@sentry/node": "^10.69.0",
    "better-auth": "catalog:",
    "sharp": "^0.35.4",
    "undici": "^7.29.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-tuums/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "dotenv-cli": "^11.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "vitest": "^4.1.10"
  }
}
