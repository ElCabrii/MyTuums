{
  "name": "@my-tuums/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 3001",
    "build": "pnpm build:worker",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm typecheck:worker",
    "test": "vitest run",
    "test:unit": "vitest run",
    "games:sync": "tsx src/games-sync.ts",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/dist",
    "types": "wrangler types worker/worker-configuration.d.ts --env-interface AppEnv --include-runtime false"
  },
  "dependencies": {
    "@my-tuums/api": "workspace:*",
    "@my-tuums/auth": "workspace:*",
    "@my-tuums/db": "workspace:*",
    "@orpc/server": "^1.5.0",
    "better-auth": "catalog:",
    "jose": "6.2.5",
    "sharp": "^0.35.4",
    "undici": "^7.29.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-tuums/tsconfig": "workspace:*",
    "@orpc/client": "1.14.13",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "vitest": "^4.1.10"
  }
}
