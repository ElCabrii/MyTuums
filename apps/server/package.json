{
  "name": "@my-tuums/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsup",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "bench:media-session": "dotenv -e ../../.env -- tsx scripts/bench-media-session-lookup.mjs"
  },
  "dependencies": {
    "@my-tuums/api": "workspace:*",
    "@my-tuums/auth": "workspace:*",
    "@my-tuums/db": "workspace:*",
    "@orpc/server": "^1.5.0",
    "better-auth": "^1.2.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-tuums/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
