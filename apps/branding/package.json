{
  "name": "@my-tuums/branding",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5174 --strictPort",
    "build": "cross-env NODE_ENV=production vite build && pnpm build:worker",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/dist",
    "types": "wrangler types worker/worker-configuration.d.ts --env-interface BrandingEnv --include-runtime false --strict-vars false"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.0.13",
    "@my-tuums/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "@typescript/native": "catalog:",
    "vite": "^8.2.2"
  }
}
