{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mytuums-production-branding",
  "account_id": "734f3b84571b1967e6940140a0b7d75f",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "about.mytuums.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "vars": {
    "BRANDING_ORIGIN": "https://about.mytuums.com",
    "ACCESS_TEAM_DOMAIN": "https://mytuums.cloudflareaccess.com",
    "ACCESS_MODE": "public",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "invocation_logs": false,
    },
  },
}
