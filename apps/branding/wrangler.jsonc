{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mytuums-build-branding",
  "account_id": "734f3b84571b1967e6940140a0b7d75f",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "vars": {
    "BRANDING_ORIGIN": "https://branding-preview.invalid",
    "ACCESS_TEAM_DOMAIN": "https://mytuums.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "6a8abc536bcca8df6a610bf39889bf089c297137124b0ce515dfb949130beca5",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
  },
}
